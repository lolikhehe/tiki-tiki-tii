# Required
BOT_TOKEN=123456:replace-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/videobot

# Telegram; set to local Bot API server for >50 MB files
TELEGRAM_API_URL=http://telegram-bot-api:8081
STORAGE_CHAT_ID=-1001234567890
WEBHOOK_URL=
WEBHOOK_PORT=8080

# Behaviour
ENABLED_SOURCES=all
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_TRANSCODES=2
MAX_CONCURRENT_UPLOADS=4
MAX_DURATION_SEC=900
MAX_FILE_MB=200
DEFAULT_MAX_HEIGHT=720
DOWNLOAD_DIR=./data/downloads
ADMIN_IDS=
DEFAULT_LANG=uk
RATE_LIMIT_PER_MIN=10
PROXY=
DISK_BUDGET_MB=4096

# Binaries
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Observability
METRICS_ADDR=0.0.0.0:9090
LOG_LEVEL=info
LOG_FORMAT=text
